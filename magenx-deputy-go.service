[Unit]
Description=Magenx Deputy (Magento release deployment webhook listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/magenx-deputy-go -config /etc/magenx-deputy-go/config.yaml
Restart=always
RestartSec=2

# Runs as root so it can drive docker (stack) and hand releases to the site user.
# deploy.run_as / stack.run_as in config.yaml pick the user that owns the releases
# and runs the commands; deputy refuses to run deploy commands as root.
# Without stack deploys, User=/Group= the site owner and no run_as works as well.
User=root
Group=root
# Only what dropping to run_as and handing files to it needs.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=

# Optional: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, IS_LEADER=true|false, REGISTRY_PASSWORD, ...
EnvironmentFile=-/etc/magenx-deputy-go/env

StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
# MemoryDenyWriteExecute is intentionally not set: leader commands run PHP
# (bin/magento), and PCRE JIT / opcache JIT need writable+executable memory.

# Make everything read-only by default
ProtectSystem=strict

# Allow write only where deputy needs to act.
# Adjust to <deploy.root_dir>/<brand> and stack.dir in /etc/magenx-deputy-go/config.yaml.
# ~/.docker (docker login) and ~/.sigstore (cosign) of the stack.run_as user, "-" = optional.
ReadWritePaths=/home/mystore -/opt/mystore -/root/.docker -/root/.sigstore

[Install]
WantedBy=multi-user.target
